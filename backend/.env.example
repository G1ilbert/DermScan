# Application
APP_NAME=DermScan
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://dermscan:dermscan@postgres:5432/dermscan

# Redis / ARQ
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production-please-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-level encryption (Fernet key, generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=GENERATE_A_REAL_FERNET_KEY_HERE_BASE64_32B==

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=dermscan-images
R2_REGION=auto

# Model
MODEL_PATH=/models/dermscan.onnx
MODEL_INPUT_SIZE=380
CONFIDENCE_THRESHOLD_HIGH=0.90
CONFIDENCE_THRESHOLD_LOW=0.70

# CORS
CORS_ORIGINS=http://localhost:3000

# Limits
MAX_UPLOAD_BYTES=10485760
