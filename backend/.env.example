# Application
APP_NAME=DermScan
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://dermscan:dermscan@postgres:5432/dermscan

# Redis / ARQ
REDIS_URL=redis://redis:6379/0

# Supabase Auth (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=dermscan-images
R2_REGION=auto

# Model
MODEL_PATH=/models/dermscan.onnx
MODEL_INPUT_SIZE=380
CONFIDENCE_THRESHOLD_HIGH=0.90
CONFIDENCE_THRESHOLD_LOW=0.70

# CORS
CORS_ORIGINS=http://localhost:3000

# Limits
MAX_UPLOAD_BYTES=10485760
