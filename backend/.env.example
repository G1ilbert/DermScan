# Application
APP_DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://dermscan:dermscan@postgres:5432/dermscan

# Supabase Auth + Storage (https://supabase.com/dashboard/project/_/settings/api)
# Storage uses two private buckets — create them in Supabase Studio:
#   - "scans"    (private) — original uploaded images
#   - "heatmaps" (private) — GradCAM heatmaps written by the worker
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Model
MODEL_PATH=/models/dermscan.onnx
MODEL_INPUT_SIZE=380

# Confidence gate thresholds (tuneable without code change)
CONFIDENCE_THRESHOLD_HIGH=0.60
CONFIDENCE_THRESHOLD_LOW=0.45
MAX_UPLOAD_BYTES=10485760

# Polling worker — replaces the old ARQ/Redis queue. Tune these to
# trade DB load (lower interval) against pickup latency (higher interval).
WORKER_POLL_INTERVAL_S=2.0
WORKER_STUCK_RESET_AFTER_S=300
